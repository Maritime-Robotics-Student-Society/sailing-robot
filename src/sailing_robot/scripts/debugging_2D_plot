#!/usr/bin/env python3
"""Node that publishes visualisation objects (for RViz)."""

import math
import rclpy
from rclpy.node import Node
from visualization_msgs.msg import Marker, MarkerArray
from sensor_msgs.msg import NavSatFix
from std_msgs.msg import Float64, Float32, String, Bool
from sailing_robot.navigation import Navigation


class Debugging2DPlot(Node):
    def __init__(self):
        super().__init__('debugging_2D_plot')

        self.declare_parameter('navigation.utm_zone', 30)

        utm_zone = self.get_parameter('navigation.utm_zone').value
        self.nav = Navigation(utm_zone=utm_zone)

        self.publisher = self.create_publisher(MarkerArray, 'debugging_2D_plot', 10)
        self.publisher_waypoint = self.create_publisher(MarkerArray, 'debugging_2D_plot_wp', 10)
        self.publisher_origin = self.create_publisher(NavSatFix, 'debugging_2D_plot_origin', 10)

        self.sailing_state = 'normal'
        self.remote_control = False
        self.gps_position = None

        self.create_subscription(String, 'sailing_state', self.update_sailing_state, 10)
        self.create_subscription(String, 'remote_control', self.update_remote_control, 10)
        self.create_subscription(NavSatFix, 'position', self.update_position, 10)

        self.timer = self.create_timer(1.0, self.publish)

    def update_sailing_state(self, msg):
        self.sailing_state = msg.data

    def update_remote_control(self, msg):
        self.remote_control = msg.data

    def update_position(self, msg):
        self.nav.update_position(msg)
        self.gps_position = msg

    def publish(self):
        if self.gps_position is None:
            return
        marker_array = MarkerArray()
        marker = Marker()
        marker.header.frame_id = 'map'
        marker.type = Marker.SPHERE
        marker.action = Marker.ADD
        marker.scale.x = 2.0
        marker.scale.y = 2.0
        marker.scale.z = 2.0
        marker.color.a = 1.0
        if self.sailing_state == 'normal':
            marker.color.g = 1.0
        else:
            marker.color.r = 1.0
        marker_array.markers.append(marker)
        self.publisher.publish(marker_array)


def main(args=None):
    rclpy.init(args=args)
    node = Debugging2DPlot()
    try:
        rclpy.spin(node)
    except KeyboardInterrupt:
        pass
    finally:
        node.destroy_node()
        rclpy.shutdown()


if __name__ == '__main__':
    main()
